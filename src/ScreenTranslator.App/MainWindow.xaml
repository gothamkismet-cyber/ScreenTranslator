<Window x:Class="ScreenTranslator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:display="clr-namespace:ScreenTranslator.Display" Style="{StaticResource {x:Type Window}}" Title="屏幕 AI 翻译 · 第一版" Width="1080" Height="760" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid Margin="28,22,28,24">
    <Grid.RenderTransform><TranslateTransform x:Name="EntranceSlide" Y="14" /></Grid.RenderTransform>
    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="EntranceSlide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- 标题栏：软件标志 + 名称，右侧是悬浮窗与设置 -->
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="悬浮窗" display:ThemeAssist.Glyph="&#xE8A7;" Click="Floating_Click"/>
        <Button Content="连接与设置" display:ThemeAssist.Glyph="&#xE713;" Click="Settings_Click"/>
        <Button Content="退出软件" Click="Exit_Click" Margin="0" ToolTip="停止翻译并退出；标题栏关闭按钮只收起主界面"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource AppIconLarge}" Width="50" Height="50" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="屏幕 AI 翻译" Style="{StaticResource PageTitle}" FontSize="27"/>
          <TextBlock Text="选窗口或框选，本地识字，用你的 AI 翻译。" Style="{StaticResource Caption}" FontSize="13" Margin="1,3,0,0"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- 连接与语言 -->
    <ContentControl Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="13"/><TextBlock Text="当前 AI 连接" Style="{StaticResource Caption}" Margin="6,0,0,0"/></StackPanel>
          <ComboBox x:Name="ProfilePicker" SelectionChanged="Profile_Changed" Margin="0,8,0,0"/>
          <TextBlock x:Name="ConnectionHint" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Text="先在“连接与设置”里填入地址、密钥和模型。"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C1;" Style="{StaticResource Glyph}" FontSize="13"/><TextBlock Text="来源语言 → 简体中文" Style="{StaticResource Caption}" Margin="6,0,0,0"/></StackPanel>
          <ComboBox x:Name="LanguagePicker" SelectionChanged="Language_Changed" Margin="0,8,0,0"><ComboBoxItem Content="英语"/><ComboBoxItem Content="日语"/><ComboBoxItem Content="韩语"/></ComboBox>
          <TextBlock Text="识字在本机完成，不上传截图" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </ContentControl>

    <!-- 三步操作 + 当前选区 -->
    <WrapPanel Grid.Row="2" Margin="0,0,0,16">
      <Button x:Name="SelectWindowButton" Content="① 选择窗口" display:ThemeAssist.Glyph="&#xE8A7;" Click="SelectWindow_Click"/>
      <Button x:Name="SelectButton" Content="或框选区域" display:ThemeAssist.Glyph="&#xE8B3;" Click="SelectRegion_Click"/>
      <Button x:Name="StartButton" Content="② 开始连续翻译" display:ThemeAssist.Glyph="&#xE768;" Style="{StaticResource AccentButton}" Click="Toggle_Click"/>
      <Button x:Name="ReadButton" Content="翻译一次 / 手动刷新" display:ThemeAssist.Glyph="&#xE72C;" Click="Read_Click"/>
      <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="4,0,0,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RegionText" Text="尚未选择范围" MaxWidth="230" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel>
      </Border>
    </WrapPanel>

    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- 左：选区预览与上手步骤 -->
      <ContentControl Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="当前屏幕区域" Style="{StaticResource SectionTitle}" FontSize="14"/>
            <Border Background="{StaticResource AccentPale}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Height="104" Margin="0,12,0,12">
              <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=RegionPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="&#xE8B3;" Style="{StaticResource Glyph}" FontSize="26" Foreground="{StaticResource InputBorder}" HorizontalAlignment="Center"/>
                  <TextBlock Text="选择范围后在这里预览" Style="{StaticResource Caption}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Image x:Name="RegionPreview" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <TextBlock x:Name="MetricsText" Text="选区截图只在内存中处理。" Style="{StaticResource Caption}" LineHeight="19"/>
            <StackPanel x:Name="FirstUseGuide">
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,12"/>
            <TextBlock Text="第一次使用" Style="{StaticResource SectionTitle}" FontSize="13"/>
            <StackPanel Margin="0,4,0,0">
              <StackPanel.Resources>
                <Style x:Key="StepNumber" TargetType="Border"><Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/><Setter Property="CornerRadius" Value="9.5"/><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                <Style x:Key="StepText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="9,0,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
              </StackPanel.Resources>
              <DockPanel Margin="0,6,0,0"><Border Style="{StaticResource StepNumber}"><TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDeep}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="填写 AI 连接" Style="{StaticResource StepText}"/></DockPanel>
              <DockPanel Margin="0,6,0,0"><Border Style="{StaticResource StepNumber}"><TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDeep}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="选语言，再选窗口或框选" Style="{StaticResource StepText}"/></DockPanel>
              <DockPanel Margin="0,6,0,0"><Border Style="{StaticResource StepNumber}"><TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDeep}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="点击开始，看悬浮窗" Style="{StaticResource StepText}"/></DockPanel>
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </ContentControl>

      <!-- 右：原文与译文 -->
      <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0.42*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="识别到的原文" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
          <TextBox x:Name="OriginalBox" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17" BorderThickness="0" Padding="0"/>
          <StackPanel Grid.Row="2" Margin="0,14,0,12">
            <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,14"/>
            <Border Background="{StaticResource AccentPale}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C1;" Style="{StaticResource Glyph}" FontSize="12"/><TextBlock Text="简体中文" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel>
            </Border>
          </StackPanel>
          <TextBox x:Name="TranslationBox" Grid.Row="3" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="22" BorderThickness="0" Padding="0" Text="设置连接并开始后，译文会显示在这里。"/>
        </Grid>
      </ContentControl>
    </Grid>

    <!-- 状态栏：圆点在连续翻译时为粉色，暂停时变浅 -->
    <ContentControl Grid.Row="4" Style="{StaticResource Callout}" Margin="0,16,0,0">
      <DockPanel>
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource InputBorder}" VerticalAlignment="Top" Margin="2,5,10,0" DockPanel.Dock="Left"><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="12"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.1"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
        <StackPanel>
          <TextBlock x:Name="StatusText" Text="准备就绪 · 请先填写 AI 连接，再选择窗口或框选区域。" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
          <TextBlock Text="关闭主界面会收起到托盘，小窗继续翻译；彻底关闭请点“退出软件”。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock x:Name="HotkeyHint" Visibility="Collapsed" Foreground="{StaticResource Warning}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>
    </ContentControl>
  </Grid>
</Window>
