<Window x:Class="ScreenTranslator.Display.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:display="clr-namespace:ScreenTranslator.Display" Style="{StaticResource {x:Type Window}}" Title="连接与显示设置" Width="1060" Height="760" MinWidth="920" MinHeight="660" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="GroupHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}"><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  </Window.Resources>
  <Grid Margin="24,20,24,22">
    <Grid.RenderTransform><TranslateTransform x:Name="EntranceSlide" Y="12" /></Grid.RenderTransform>
    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="EntranceSlide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25">
              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <Image Source="{StaticResource AppIconLarge}" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="连接与显示设置" Style="{StaticResource PageTitle}" FontSize="24"/>
        <TextBlock Text="填写你自己的 AI 服务地址和模型。密钥由当前 Windows 用户保护。" Style="{StaticResource Caption}" FontSize="13" Margin="1,3,0,0"/>
      </StackPanel>
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1">
      <TabItem Header="AI 连接" display:ThemeAssist.Glyph="&#xE71B;">
        <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="已保存的连接" Style="{StaticResource FieldLabel}"/>
            <ListBox x:Name="ProfilesList" Grid.Row="1" SelectionChanged="Profile_Changed" Padding="5"/>
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,0">
              <Button Content="新增" display:ThemeAssist.Glyph="&#xE710;" Style="{StaticResource CompactButton}" Padding="6,6" Click="Add_Click" Margin="0,0,4,0"/>
              <Button Content="复制" display:ThemeAssist.Glyph="&#xE8C8;" Style="{StaticResource CompactButton}" Padding="6,6" Click="Duplicate_Click" Margin="2,0,2,0"/>
              <Button Content="删除" display:ThemeAssist.Glyph="&#xE74D;" Style="{StaticResource CompactButton}" Padding="6,6" Click="Delete_Click" Margin="4,0,0,0"/>
            </UniformGrid>
          </Grid>
          <Border Grid.Column="1" Width="1" Background="{StaticResource Divider}" HorizontalAlignment="Center"/>
          <ScrollViewer x:Name="FormScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormPanel" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE774;" Style="{StaticResource Glyph}"/><TextBlock Text="服务与地址" Style="{StaticResource GroupHeading}"/></StackPanel>
              <TextBlock Text="连接名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" TextChanged="Name_Changed" Margin="0,0,0,14"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="API 格式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FormatBox" SelectionChanged="Endpoint_Changed" Margin="0,0,0,14"><ComboBoxItem Content="Chat Completions"/><ComboBoxItem Content="Responses"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="地址填写方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AddressModeBox" SelectionChanged="Endpoint_Changed" Margin="0,0,0,14"><ComboBoxItem Content="基础地址（自动附加接口路径）"/><ComboBoxItem Content="完整请求地址（按原地址请求）"/></ComboBox></StackPanel>
              </Grid>
              <TextBlock Text="服务地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AddressBox" TextChanged="Address_Changed" Margin="0,0,0,8" ToolTip="例如 https://example.com/v1；软件不会自行添加 /v1"/>
              <Border Background="{StaticResource AccentPale}" CornerRadius="8" Padding="10,7" Margin="0,0,0,22">
                <DockPanel><TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"/><TextBlock x:Name="EndpointText" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"/></DockPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}"/><TextBlock Text="认证与模型" Style="{StaticResource GroupHeading}"/></StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="认证方式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AuthBox" SelectionChanged="Endpoint_Changed" Margin="0,0,0,14"><ComboBoxItem Content="Bearer 密钥"/><ComboBoxItem Content="指定密钥请求头"/><ComboBoxItem Content="无认证（仅本机服务）"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="密钥请求头名称（指定头时使用）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="KeyHeaderBox" Margin="0,0,0,14"/></StackPanel>
              </Grid>
              <TextBlock Text="API 密钥" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="KeyBox" Margin="0,0,0,14"/>
              <TextBlock Text="模型名称（可直接手填）" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,14"><Button x:Name="ModelsButton" DockPanel.Dock="Right" Content="获取列表" display:ThemeAssist.Glyph="&#xE8FD;" Click="Models_Click" Margin="10,0,0,0"/><ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="False"/></DockPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="StreamBox" Content="流式显示：边生成边显示译文" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Grid.Column="2"><TextBlock Text="请求超时（秒，5–120）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TimeoutBox" Margin="0,0,0,14"/></StackPanel>
              </Grid>
              <Expander x:Name="AdvancedExpander" Header="高级参数：服务需要时再填写" Margin="0,4,0,16">
                <StackPanel Margin="0,4,0,0">
                  <TextBlock Text="最大输出字段（默认不发送）" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LimitBox" Margin="0,0,0,12"><ComboBoxItem Content="不发送"/><ComboBoxItem Content="max_tokens"/><ComboBoxItem Content="max_completion_tokens"/><ComboBoxItem Content="max_output_tokens"/></ComboBox>
                  <TextBlock Text="输出数量限制" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxOutputBox" Margin="0,0,0,12"/>
                  <TextBlock Text="额外请求头（JSON，所有值均受保护）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" VerticalContentAlignment="Top" Margin="0,0,0,12" FontFamily="Cascadia Mono, Consolas"/>
                  <TextBlock Text="额外请求参数（JSON，不可覆盖模型、原文等核心字段）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas"/>
                </StackPanel>
              </Expander>
              <ContentControl Style="{StaticResource Callout}" Padding="14,12">
                <StackPanel>
                  <DockPanel><TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Warning}" FontSize="13" VerticalAlignment="Top" Margin="0,2,8,0"/><TextBlock Text="测试会发送一条固定英语短句，服务可能计费。" TextWrapping="Wrap"/></DockPanel>
                  <Button x:Name="TestButton" Content="发送测试短句" display:ThemeAssist.Glyph="&#xE724;" HorizontalAlignment="Left" Click="Test_Click" Margin="0,10,0,0"/>
                  <TextBlock x:Name="TestText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="悬浮窗与快捷键" display:ThemeAssist.Glyph="&#xE765;">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26,22,26,22" Width="700" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE890;" Style="{StaticResource Glyph}"/><TextBlock Text="悬浮窗外观" Style="{StaticResource GroupHeading}"/></StackPanel>
          <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
            <StackPanel>
              <CheckBox x:Name="OriginalCheck" Content="悬浮窗显示原文" Margin="0,0,0,18"/>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=FontSlider, StringFormat={}{0:0} px}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="译文字号" Style="{StaticResource FieldLabel}"/></DockPanel>
              <Slider x:Name="FontSlider" Minimum="16" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,18"/>
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="悬浮窗不透明度" Style="{StaticResource FieldLabel}"/></DockPanel>
              <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
            </StackPanel>
            <!-- 实时预览：字号与不透明度跟随滑块 -->
            <Border Grid.Column="2" Background="{StaticResource AccentPale}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Opacity="{Binding Value, ElementName=OpacitySlider}">
              <StackPanel>
                <TextBlock Text="预览" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <TextBlock Text="You have 250 gold coins." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" Visibility="{Binding IsChecked, ElementName=OriginalCheck, Converter={StaticResource VisibleWhenTrue}}"/>
                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                  <TextBlock Text="你有 250 枚金币。" FontSize="{Binding Value, ElementName=FontSlider}" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}"/><TextBlock Text="全局快捷键" Style="{StaticResource GroupHeading}"/></StackPanel>
          <TextBlock Text="例如 Ctrl+Alt+T；保存后注册，冲突会提示。留空即关闭该快捷键。" Style="{StaticResource Caption}" Margin="0,4,0,14"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="选择区域" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SelectKeyBox" Margin="0,0,0,14"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="开始 / 暂停" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PauseKeyBox" Margin="0,0,0,14"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="显示 / 隐藏悬浮窗" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FloatingKeyBox" Margin="0,0,0,14"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="手动刷新（会重新发送当前原文）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RefreshKeyBox" Margin="0,0,0,14"/></StackPanel>
          </Grid>
          <ContentControl Style="{StaticResource Callout}" Margin="0,6,0,0">
            <DockPanel><TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Top" Margin="0,2,8,0"/><TextBlock Text="选区固定在屏幕位置。窗口移动或显示器缩放改变后，请重新选区。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DockPanel>
          </ContentControl>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="导出配置（不含密钥）" display:ThemeAssist.Glyph="&#xEDE1;" HorizontalAlignment="Left" Click="Export_Click"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True"/><Button Content="保存并使用当前连接" display:ThemeAssist.Glyph="&#xE73E;" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
