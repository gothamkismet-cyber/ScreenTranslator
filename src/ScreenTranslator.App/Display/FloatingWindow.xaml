<Window x:Class="ScreenTranslator.Display.FloatingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:display="clr-namespace:ScreenTranslator.Display" Style="{StaticResource {x:Type Window}}" Title="屏幕译文" Width="514" Height="464" MinWidth="384" MinHeight="304" Topmost="True" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" display:ThemeAssist.TintCaption="False">
  <!-- 无边框圆角窗：AllowsTransparency 让“不透明度”设置真正透出下方画面（普通窗口只会把内容压暗）。
       外圈 12 留给阴影和拖动改变大小，Alpha 为 1 的底色让这一圈仍能接收鼠标。 -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="10" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid Background="#01000000">
    <Border Margin="12" CornerRadius="14" Background="{StaticResource AccentPale}">
      <Border.Effect><DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.24" RenderingBias="Performance" /></Border.Effect>
    </Border>
    <Border Margin="12" CornerRadius="14" Background="{StaticResource AccentPale}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" SnapsToDevicePixels="True">
      <Grid>
        <Grid.RenderTransform><TranslateTransform x:Name="EntranceSlide" Y="10" /></Grid.RenderTransform>
        <Grid.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="EntranceSlide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- 标题栏：按住空白处拖动窗口 -->
        <Border x:Name="TitleBar" Background="Transparent" Padding="14,10,8,8" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Cursor="Arrow">
              <Button x:Name="MainButton" Content="&#xE80F;" Style="{StaticResource IconButton}" ToolTip="打开主界面" Click="Main_Click"/>
              <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource IconButton}" ToolTip="选择范围、设置与退出" Click="More_Click">
                <Button.ContextMenu>
                  <ContextMenu x:Name="MoreMenu">
                    <MenuItem Header="选择窗口" Click="Window_Click"/>
                    <MenuItem Header="框选区域" Click="Region_Click"/>
                    <MenuItem Header="翻译一次 / 刷新" Click="Refresh_Click"/>
                    <MenuItem Header="连接与设置" Click="Settings_Click"/>
                    <Separator/>
                    <MenuItem Header="打开主界面" Click="Main_Click"/>
                    <MenuItem x:Name="ExitMenuItem" Header="退出软件" Click="Exit_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <CheckBox x:Name="PinCheck" Content="置顶" Style="{StaticResource PinToggle}" IsChecked="True" Checked="Pin_Changed" Unchecked="Pin_Changed" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" ToolTip="隐藏悬浮窗" Click="Hide_Click"/>
            </StackPanel>
            <Image Source="{StaticResource AppIconSmall}" Width="18" Height="18" VerticalAlignment="Center"/>
            <TextBlock Text="屏幕译文" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </DockPanel>
        </Border>

        <StackPanel x:Name="OriginalPanel" Grid.Row="1" Margin="16,2,16,10">
          <TextBlock Text="原文" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
          <TextBox x:Name="OriginalBox" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontSize="14" Foreground="{StaticResource Muted}" BorderThickness="0" Padding="0"/>
        </StackPanel>
        <ContentControl Grid.Row="2" Style="{StaticResource Card}" Padding="16,14" Margin="12,0,12,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{StaticResource AccentPale}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C1;" Style="{StaticResource Glyph}" FontSize="12"/><TextBlock Text="简体中文" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel>
            </Border>
            <TextBox x:Name="TranslationBox" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="20" BorderThickness="0" Padding="0"/>
          </Grid>
        </ContentControl>

        <!-- 底栏：状态 + 开始 / 暂停、复制 -->
        <DockPanel Grid.Row="3" Margin="16,10,12,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PauseButton" Content="开始" display:ThemeAssist.Glyph="&#xE768;" Style="{StaticResource CompactButton}" Click="Pause_Click"/>
            <Button x:Name="CopyButton" Content="复制译文" display:ThemeAssist.Glyph="&#xE8C8;" Style="{StaticResource CompactButton}" Click="Copy_Click" Margin="0"/>
          </StackPanel>
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource InputBorder}" VerticalAlignment="Center" Margin="1,0,9,0" DockPanel.Dock="Left"><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="12"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.1"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
          <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="准备开始" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,10,0"/>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
