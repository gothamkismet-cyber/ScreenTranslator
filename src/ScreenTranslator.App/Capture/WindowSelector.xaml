<Window x:Class="ScreenTranslator.Capture.WindowSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:display="clr-namespace:ScreenTranslator.Display" Style="{StaticResource {x:Type Window}}" Title="选择要翻译的窗口" Width="680" Height="510" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="刷新列表" display:ThemeAssist.Glyph="&#xE72C;" Click="Refresh_Click" Margin="12,0,0,0"/>
      <TextBlock Text="选择要翻译的窗口" Style="{StaticResource SectionTitle}" FontSize="20" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Grid.Row="1" Text="选择浏览器、游戏或其他软件当前可见的窗口。窗口移动或改变大小后，翻译范围会跟着更新。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <ListBox Grid.Row="2" x:Name="WindowList" DisplayMemberPath="Title" SelectionChanged="Window_Changed" MouseDoubleClick="Window_DoubleClick" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Background="White" Padding="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ToolTip" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
    <TextBlock Grid.Row="3" x:Name="HintText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,14" Text="窗口需要保持可见；关闭、最小化或被其他软件遮住时，翻译会暂停。"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Margin="0,0,10,0"/>
      <Button x:Name="UseButton" Content="使用这个窗口" IsDefault="True" IsEnabled="False" Style="{StaticResource AccentButton}" Click="Use_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
