<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 由 scripts/BuildIcon.ps1 从 Themes/AppIcon.xaml 生成；exe、任务栏和各窗口共用。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>ScreenTranslator</AssemblyName>
    <RootNamespace>ScreenTranslator</RootNamespace>
    <Version>0.1.0</Version>
    <!-- This is a WPF application; WinForms is used only for monitor enumeration. WPF DPI is declared in the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build" />
    <Content Include="../../models/**/*" Link="models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>
